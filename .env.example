# ---------------------------------------------------------------------------
# Laya Credit Decision Engine - configuration
# Copy to .env and edit:   cp .env.example .env
# .env is git-ignored. Never commit real credentials (RBI / CERT-In hygiene).
# ---------------------------------------------------------------------------

# --- PostgreSQL (pgvector) --------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=laya_credit
PG_USER=laya
PG_PASSWORD=change_me_local_only

# --- Decision backend -------------------------------------------------------
# laya = real Laya inference (local, open weights)   mock = keyword stand-in for CI
DECISION_BACKEND=laya
# auto = Laya Router picks english / multilingual per request; or pin: english | multilingual | typed-decisions
LAYA_MODEL=auto
# Pin the Hugging Face commit SHA of the checkpoint you validated (MLOps reproducibility). Empty = latest.
LAYA_REVISION=
# cpu | cuda | mps | xpu ; empty = auto-detect
LAYA_DEVICE=
# Optional token budget override (e.g. 2048 with LAYA_MODEL=multilingual for long narratives)
LAYA_MAX_LEN=
# Answers below this calibrated confidence are withheld and the case is REFERRED to a human
LAYA_MIN_CONFIDENCE=0.70

# --- RAG ------------------------------------------------------------------------
# hashing = offline, zero-download lexical embedding | sentence-transformers = local semantic model
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Policy clauses passed to the model per decision (keep small: English checkpoint reads 512 tokens)
RAG_TOP_K=5

# --- Governance -------------------------------------------------------------------
REDACT_PII=true
REQUIRE_REGISTERED_MODEL=true
MODEL_APPROVER=model-risk-committee

# --- Data residency: after the first model download, run fully offline -------------
# HF_HUB_OFFLINE=1
# HF_HUB_CACHE=/opt/models/hf-cache
